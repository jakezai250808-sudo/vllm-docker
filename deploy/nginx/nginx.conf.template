worker_processes auto;
error_log /dev/stderr warn;
pid /tmp/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" "$http_x_forwarded_for"';

    access_log /dev/stdout main;
    sendfile on;
    keepalive_timeout 65;

    limit_req_zone $binary_remote_addr zone=llm_per_ip:10m rate=__LIMIT_REQ_RATE__;

    server {
        listen 8080;
        server_name _;

        client_max_body_size __MAX_BODY_SIZE__;

        # IP allowlist: RFC1918 + example VPN subnet.
        allow 10.0.0.0/8;
        allow 172.16.0.0/12;
        allow 192.168.0.0/16;
        allow 10.8.0.0/24;
        deny all;

        location / {
__LIMIT_REQ_DIRECTIVE__
            if ($http_authorization != "Bearer __API_KEY__") {
                return 401;
            }

            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            proxy_connect_timeout __PROXY_CONNECT_TIMEOUT__;
            proxy_read_timeout __PROXY_READ_TIMEOUT__;
            proxy_send_timeout __PROXY_SEND_TIMEOUT__;

            proxy_pass http://inference:8000;
        }
    }
}
