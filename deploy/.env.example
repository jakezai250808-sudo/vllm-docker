API_KEY=change-me
GATEWAY_PORT=8080
MAX_BODY_SIZE=50m
TP=2
MAX_MODEL_LEN=65536
DTYPE=auto
CUDA_VISIBLE_DEVICES=
IMAGE_INFERENCE=corp/qwen3-coder-next-vllm:offline
IMAGE_GATEWAY=nginx:stable
NETWORK_NAME=llm-net
INFERENCE_CONTAINER_NAME=inference
GATEWAY_CONTAINER_NAME=llm-gateway
INFERENCE_PORT=8000
PROXY_CONNECT_TIMEOUT=30s
PROXY_READ_TIMEOUT=600s
PROXY_SEND_TIMEOUT=600s
LIMIT_REQ_RATE=20r/s
LIMIT_REQ_BURST=40
ENABLE_RATE_LIMIT=off

HF_CONDA_ENV=llm-offline-hf
HF_CONDA_PYTHON=3.10

VLLM_BASE_IMAGE=vllm/vllm-openai:latest
DOCKER_PULL_RETRIES=3
DOCKER_PULL_RETRY_WAIT=10
SKIP_GATEWAY_PULL=0
SKIP_VLLM_BASE_PULL=0
ZSTD_LEVEL=19
ZSTD_THREADS=0

# 镜像加速配置：default / cn
MIRROR_PROFILE=default
# 当 MIRROR_PROFILE=cn 且你未手动指定 IMAGE_GATEWAY/VLLM_BASE_IMAGE 时，将自动切换到以下镜像
CN_IMAGE_GATEWAY=docker.m.daocloud.io/library/nginx:stable
CN_VLLM_BASE_IMAGE=docker.m.daocloud.io/vllm/vllm-openai:latest

# 一体化发布包只打入匹配该通配符的镜像包（避免把历史包反复再打包）
RELEASE_BUNDLE_MODE=zst
# 可选：zst|tar|both；若设置 RELEASE_BUNDLE_GLOB，则优先使用 glob
RELEASE_BUNDLE_GLOB=

# 打包完成后清理本地镜像，避免反复运行占满磁盘
CLEANUP_LOCAL_IMAGES=1
# 是否连 vLLM 基础镜像也删除（下次会重新拉取）
CLEANUP_BASE_IMAGE=0
# 是否清理 dangling 镜像层
CLEANUP_PRUNE_DANGLING=1
